# Copy this file to .env and adjust the values: cp .env.example .env

# --- PostgreSQL (used by docker-compose.dev.yml) ---
POSTGRES_USER=trackify
POSTGRES_PASSWORD=change_me
POSTGRES_DB=trackify
POSTGRES_PORT=5433   # host port; change if it clashes with another local Postgres

# --- Redis (used by docker-compose.dev.yml) ---
REDIS_PORT=6380      # host port; change if it clashes with another local Redis

# --- Application ---
# The password and ports below must match the values above
DATABASE_URL=postgres://trackify:change_me@localhost:5433/trackify
REDIS_URL=redis://localhost:6380
PORT=3000